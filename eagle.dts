/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "Qualcomm MSM 8926 MTP";
	compatible = "qcom,msm8926-mtp", "qcom,msm8926", "qcom,mtp";
	interrupt-parent = <0x01>;
	qcom,msm-id = <0xc8 0x20000 0xe0 0x20000>;
	qcom,board-id = <0x08 0x00>;

	chosen {
	};

	aliases {
		spi0 = "/soc/spi@f9923000";
		sdhc1 = "/soc/sdhci@f9824900";
		sdhc2 = "/soc/sdhci@f98a4900";
		sdhc3 = "/soc/sdhci@f9864900";
	};

	memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		device_type = "memory";
		reg = <0x00 0x00>;

		secure_region {
			linux,contiguous-region;
			reg = <0x00 0x6d00000>;
			label = "secure_mem";
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		adsp_region {
			linux,contiguous-region;
			reg = <0x00 0x2a00000>;
			label = "adsp_mem";
			linux,phandle = <0x03>;
			phandle = <0x03>;
		};

		qsecom_region {
			linux,contiguous-region;
			reg = <0x00 0xd00000>;
			label = "qsecom_mem";
			linux,memory-limit = <0x00>;
			linux,phandle = <0x04>;
			phandle = <0x04>;
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		qcom,ion {
			compatible = "qcom,msm-ion";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qcom,ion-heap@25 {
				reg = <0x19>;
				qcom,ion-heap-type = "SYSTEM";
			};

			qcom,ion-heap@8 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x08>;
				qcom,heap-align = <0x1000>;
				linux,contiguous-region = <0x02>;
				qcom,ion-heap-type = "SECURE_DMA";
				qcom,default-prefetch-size = <0x3c00000>;
			};

			qcom,ion-heap@22 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x16>;
				qcom,heap-align = <0x1000>;
				linux,contiguous-region = <0x03>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@27 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1b>;
				linux,contiguous-region = <0x04>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@28 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1c>;
				qcom,heap-align = <0x1000>;
				qcom,memory-reservation-type = "EBI1";
				qcom,memory-reservation-size = "", "1@";
				qcom,ion-heap-type = "CARVEOUT";
			};

			qcom,ion-heap@23 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x17>;
				qcom,heap-align = <0x1000>;
				qcom,memory-fixed = <0xdc00000 0x1900000>;
				qcom,ion-heap-type = "CARVEOUT";
			};
		};

		qcom,msm-cam@fd8c0000 {
			compatible = "qcom,msm-cam";
			reg = <0xfd8c0000 0x10000>;
			reg-names = "msm-cam";
		};

		qcom,csiphy@fda0ac00 {
			cell-index = <0x00>;
			compatible = "qcom,csiphy";
			reg = <0xfda0ac00 0x200 0xfda00030 0x04>;
			reg-names = "csiphy", "csiphy_clk_mux";
			interrupts = <0x00 0x4e 0x00>;
			interrupt-names = "csiphy";
		};

		qcom,csiphy@fda0b000 {
			cell-index = <0x01>;
			compatible = "qcom,csiphy";
			reg = <0xfda0b000 0x200 0xfda00038 0x04>;
			reg-names = "csiphy", "csiphy_clk_mux";
			interrupts = <0x00 0x4f 0x00>;
			interrupt-names = "csiphy";
		};

		qcom,csid@fda08000 {
			cell-index = <0x00>;
			compatible = "qcom,csid";
			reg = <0xfda08000 0x100>;
			reg-names = "csid";
			interrupts = <0x00 0x33 0x00>;
			interrupt-names = "csid";
			qcom,csi-vdd-voltage = <0x124f80>;
			qcom,mipi-csi-vdd-supply = <0x05>;
		};

		qcom,csid@fda08400 {
			cell-index = <0x01>;
			compatible = "qcom,csid";
			reg = <0xfda08400 0x100>;
			reg-names = "csid";
			interrupts = <0x00 0x34 0x00>;
			interrupt-names = "csid";
			qcom,csi-vdd-voltage = <0x124f80>;
			qcom,mipi-csi-vdd-supply = <0x05>;
		};

		qcom,ispif@fda0a000 {
			cell-index = <0x00>;
			compatible = "qcom,ispif";
			reg = <0xfda0a000 0x500 0xfda00020 0x10>;
			reg-names = "ispif", "csi_clk_mux";
			interrupts = <0x00 0x37 0x00>;
			interrupt-names = "ispif";
		};

		qcom,vfe@fda10000 {
			cell-index = <0x00>;
			compatible = "qcom,vfe40";
			reg = <0xfda10000 0x1000 0xfda40000 0x200 0xfd4a8000 0x04>;
			reg-names = "vfe", "vfe_vbif", "tcsr";
			interrupts = <0x00 0x39 0x00>;
			interrupt-names = "vfe";
			vdd-supply = <0x06>;
		};

		qcom,jpeg@fda1c000 {
			cell-index = <0x00>;
			compatible = "qcom,jpeg";
			reg = <0xfda1c000 0x400>;
			reg-names = "jpeg";
			interrupts = <0x00 0x3b 0x00>;
			interrupt-names = "jpeg";
			vdd-supply = <0x07>;
		};

		qcom,irqrouter@fda00000 {
			cell-index = <0x00>;
			compatible = "qcom,irqrouter";
			reg = <0xfda00000 0x100>;
			reg-names = "irqrouter";
		};

		qcom,cpp@fda04000 {
			cell-index = <0x00>;
			compatible = "qcom,cpp";
			reg = <0xfda04000 0x100 0xfda40000 0x200 0xfda18000 0x18>;
			reg-names = "cpp", "cpp_vbif", "cpp_hw";
			interrupts = <0x00 0x31 0x00>;
			interrupt-names = "cpp";
			vdd-supply = <0x06>;
		};

		qcom,cci@fda0c000 {
			cell-index = <0x00>;
			compatible = "qcom,cci";
			reg = <0xfda0c000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg-names = "cci";
			interrupts = <0x00 0x32 0x00>;
			interrupt-names = "cci";
			gpios = <0x08 0x1d 0x00 0x08 0x1e 0x00>;
			qcom,gpio-tbl-num = <0x00 0x01>;
			qcom,gpio-tbl-flags = <0x01 0x01>;
			qcom,gpio-tbl-label = "CCI_I2C_DATA0", "CCI_I2C_CLK0";

			qcom,cci-master0 {
				status = "ok";
				qcom,hw-thigh = <0x14>;
				qcom,hw-tlow = <0x1c>;
				qcom,hw-tsu-sto = <0x15>;
				qcom,hw-tsu-sta = <0x15>;
				qcom,hw-thd-dat = <0x0d>;
				qcom,hw-thd-sta = <0x12>;
				qcom,hw-tbuf = <0x19>;
				qcom,hw-scl-stretch-en = <0x00>;
				qcom,hw-trdhld = <0x06>;
				qcom,hw-tsp = <0x03>;
			};

			qcom,cci-master1 {
				status = "ok";
				qcom,hw-thigh = <0x14>;
				qcom,hw-tlow = <0x1c>;
				qcom,hw-tsu-sto = <0x15>;
				qcom,hw-tsu-sta = <0x15>;
				qcom,hw-thd-dat = <0x0d>;
				qcom,hw-thd-sta = <0x12>;
				qcom,hw-tbuf = <0x19>;
				qcom,hw-scl-stretch-en = <0x00>;
				qcom,hw-trdhld = <0x06>;
				qcom,hw-tsp = <0x03>;
			};

			qcom,actuator@18 {
				cell-index = <0x08>;
				reg = <0x18>;
				compatible = "qcom,actuator";
				qcom,cci-master = <0x00>;
				linux,phandle = <0x0d>;
				phandle = <0x0d>;
			};

			qcom,eeprom@a0 {
				cell-index = <0x00>;
				reg = <0xa0 0x00>;
				qcom,eeprom-name = "holly";
				compatible = "qcom,eeprom";
				qcom,slave-addr = <0xa0>;
				qcom,cci-master = <0x00>;
				qcom,num-blocks = <0x08>;
				qcom,page0 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll0 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem0 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				qcom,page1 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll1 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem1 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				qcom,page2 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll2 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem2 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				qcom,page3 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll3 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem3 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				qcom,page4 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll4 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem4 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				qcom,page5 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll5 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem5 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				qcom,page6 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll6 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem6 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				qcom,page7 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,poll7 = <0x00 0x00 0x02 0x00 0x01 0x14>;
				qcom,mem7 = <0x100 0x00 0x01 0x00 0x01 0x00>;
				cam_vdig-supply = <0x09>;
				cam_vio-supply = <0x0a>;
				cam_vana-supply = <0x0b>;
				cam_vaf-supply = <0x0c>;
				qcom,cam-vreg-name = "cam_vdig", "cam_vio", "cam_vana", "cam_vaf";
				qcom,cam-vreg-type = <0x00 0x01 0x00 0x00>;
				qcom,cam-vreg-min-voltage = <0x100590 0x00 0x2b7cd0 0x2ab980>;
				qcom,cam-vreg-max-voltage = <0x100590 0x00 0x2b7cd0 0x2ab980>;
				qcom,cam-vreg-op-mode = <0x100590 0x00 0x2b7cd0 0x2ab980>;
				qcom,gpio-no-mux = <0x00>;
				gpios = <0x08 0x1a 0x00 0x08 0x25 0x00 0x08 0x24 0x00 0x08 0x45 0x00>;
				qcom,gpio-reset = <0x01>;
				qcom,gpio-standby = <0x02>;
				qcom,gpio-vio = <0x03>;
				qcom,gpio-req-tbl-num = <0x00 0x01 0x02 0x03>;
				qcom,gpio-req-tbl-flags = <0x00 0x00 0x00 0x00>;
				qcom,gpio-req-tbl-label = "CAMIF_MCLK", "CAM_RESET1", "CAM_STANDBY", "CAM_IFVDD";
				qcom,cam-power-seq-type = "sensor_vreg", "sensor_vreg", "sensor_vreg", "sensor_vreg";
				qcom,cam-power-seq-val = "cam_vio", "cam_vdig", "cam_vana", "cam_vaf";
				qcom,cam-power-seq-cfg-val = <0x00 0x00 0x00 0x00>;
				qcom,cam-power-seq-delay = <0x00 0x00 0x00 0x00>;
				linux,phandle = <0x0e>;
				phandle = <0x0e>;
			};

			qcom,camera@20 {
				compatible = "qcom,imx134";
				reg = <0x20>;
				qcom,slave-id = <0x20 0x16 0x134>;
				qcom,csiphy-sd-index = <0x00>;
				qcom,csid-sd-index = <0x00>;
				qcom,actuator-src = <0x0d>;
				qcom,eeprom-src = <0x0e>;
				qcom,led-flash-src = <0x0f>;
				qcom,mount-angle = <0x5a>;
				qcom,sensor-name = "imx134";
				cam_vdig-supply = <0x09>;
				cam_vio-supply = <0x0a>;
				cam_vana-supply = <0x0b>;
				cam_vaf-supply = <0x0c>;
				qcom,cam-vreg-name = "cam_vdig", "cam_vio", "cam_vana", "cam_vaf";
				qcom,cam-vreg-type = <0x00 0x01 0x00 0x00>;
				qcom,cam-vreg-min-voltage = <0x100590 0x00 0x2b7cd0 0x2ab980>;
				qcom,cam-vreg-max-voltage = <0x100590 0x00 0x2b7cd0 0x2ab980>;
				qcom,cam-vreg-op-mode = <0x100590 0x00 0x2b7cd0 0x2ab980>;
				qcom,gpio-no-mux = <0x00>;
				gpios = <0x08 0x1a 0x00 0x08 0x25 0x00 0x08 0x24 0x00 0x08 0x45 0x00>;
				qcom,gpio-reset = <0x01>;
				qcom,gpio-standby = <0x02>;
				qcom,gpio-vio = <0x03>;
				qcom,gpio-req-tbl-num = <0x00 0x01 0x02 0x03>;
				qcom,gpio-req-tbl-flags = <0x01 0x00 0x00 0x00>;
				qcom,gpio-req-tbl-label = "CAMIF_MCLK", "CAM_RESET1", "CAM_STANDBY", "CAM_IFVDD";
				qcom,csi-lane-assign = <0x4320>;
				qcom,csi-lane-mask = <0x1f>;
				qcom,sensor-position = <0x00>;
				qcom,sensor-mode = <0x00>;
				qcom,cci-master = <0x00>;
				status = "ok";
			};

			qcom,camera@42 {
				compatible = "shinetech,gc0339";
				reg = <0x42>;
				qcom,slave-id = <0x42 0x00 0xc8>;
				qcom,csiphy-sd-index = <0x01>;
				qcom,csid-sd-index = <0x01>;
				qcom,mount-angle = <0x10e>;
				qcom,sensor-name = "SKUAA_ST_gc0339_sensor";
				cam_vdig-supply = <0x09>;
				cam_vio-supply = <0x0a>;
				cam_vana-supply = <0x0b>;
				qcom,cam-vreg-name = "cam_vdig", "cam_vio", "cam_vana";
				qcom,cam-vreg-type = <0x00 0x01 0x00>;
				qcom,cam-vreg-min-voltage = <0x124f80 0x00 0x2b7cd0>;
				qcom,cam-vreg-max-voltage = <0x124f80 0x00 0x2b7cd0>;
				qcom,cam-vreg-op-mode = <0x124f80 0x00 0x2b7cd0>;
				qcom,gpio-no-mux = <0x00>;
				gpios = <0x08 0x1b 0x00 0x08 0x1c 0x00 0x08 0x23 0x00 0x08 0x45 0x00>;
				qcom,gpio-reset = <0x01>;
				qcom,gpio-standby = <0x02>;
				qcom,gpio-vio = <0x03>;
				qcom,gpio-req-tbl-num = <0x00 0x01 0x02 0x03>;
				qcom,gpio-req-tbl-flags = <0x01 0x00 0x00 0x00>;
				qcom,gpio-req-tbl-label = "CAMIF_MCLK", "CAM_RESET", "CAM_STANDBY", "CAM_MVDD";
				qcom,csi-lane-assign = <0x4320>;
				qcom,csi-lane-mask = <0x03>;
				qcom,sensor-position = <0x01>;
				qcom,sensor-mode = <0x01>;
				qcom,cci-master = <0x00>;
				status = "ok";
			};
		};

		qcom,gdsc@fd8c1024 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus";
			reg = <0xfd8c1024 0x04>;
			status = "ok";
			qcom,clock-names = "core_clk";
			linux,phandle = <0x11>;
			phandle = <0x11>;
		};

		qcom,gdsc@fd8c1040 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core0";
			reg = <0xfd8c1040 0x04>;
			status = "disabled";
		};

		qcom,gdsc@fd8c1044 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core1";
			reg = <0xfd8c1044 0x04>;
			status = "disabled";
		};

		qcom,gdsc@fd8c1404 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_vpu";
			reg = <0xfd8c1404 0x04>;
			status = "disabled";
		};

		qcom,gdsc@fd8c2304 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_mdss";
			reg = <0xfd8c2304 0x04>;
			status = "ok";
			qcom,clock-names = "core_clk", "lut_clk";
			linux,phandle = <0x10>;
			phandle = <0x10>;
		};

		qcom,gdsc@fd8c35a4 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_jpeg";
			reg = <0xfd8c35a4 0x04>;
			status = "ok";
			qcom,clock-names = "core_clk";
			linux,phandle = <0x07>;
			phandle = <0x07>;
		};

		qcom,gdsc@fd8c36a4 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_vfe";
			reg = <0xfd8c36a4 0x04>;
			status = "ok";
			qcom,clock-names = "core_clk", "csi_clk", "cpp_clk";
			linux,phandle = <0x06>;
			phandle = <0x06>;
		};

		qcom,gdsc@fd8c4024 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_oxili_gx";
			reg = <0xfd8c4024 0x04>;
			status = "disabled";
			linux,phandle = <0x13>;
			phandle = <0x13>;
		};

		qcom,gdsc@fd8c4034 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_oxili_cx";
			reg = <0xfd8c4034 0x04>;
			status = "ok";
			qcom,clock-names = "core_clk";
			linux,phandle = <0x12>;
			phandle = <0x12>;
		};

		qcom,gdsc@fc400404 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_usb_hsic";
			reg = <0xfc400404 0x04>;
			status = "ok";
			linux,phandle = <0x42>;
			phandle = <0x42>;
		};

		qcom,gdsc@fc401ac4 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_pcie_0";
			reg = <0xfc401ac4 0x04>;
			status = "disabled";
		};

		qcom,gdsc@fc401b44 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_pcie_1";
			reg = <0xfc401b44 0x04>;
			status = "disabled";
		};

		qcom,gdsc@fc401e84 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_usb30";
			reg = <0xfc401e84 0x04>;
			status = "disabled";
		};

		qcom,gdsc@fc401ec0 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_usb30_sec";
			reg = <0xfc401ec0 0x04>;
			status = "disabled";
		};

		qcom,gdsc@fd8c1804 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_vcap";
			reg = <0xfd8c1804 0x04>;
			status = "disabled";
		};

		qcom,iommu@fda64000 {
			compatible = "qcom,msm-smmu-v1";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			reg = <0xfda64000 0x10000>;
			reg-names = "iommu_base";
			interrupts = <0x00 0x43 0x00>;
			qcom,needs-alt-core-clk;
			label = "jpeg_iommu";
			status = "ok";
			qcom,msm-bus,name = "jpeg_ebi";
			qcom,msm-bus,num-cases = <0x02>;
			qcom,msm-bus,num-paths = <0x01>;
			qcom,msm-bus,vectors-KBps = <0x3e 0x200 0x00 0x00 0x3e 0x200 0x00 0x3e8>;
			qcom,iommu-pmu-ngroups = <0x01>;
			qcom,iommu-pmu-ncounters = <0x08>;
			qcom,iommu-pmu-event-classes = <0x00 0x01 0x08 0x09 0x0a 0x10 0x11 0x12 0x80 0x81 0x82 0x83 0x90 0x91 0x92 0xb0 0xb1>;
			qcom,iommu-bfb-regs = <0x204c 0x2050 0x2514 0x2540 0x256c 0x2314 0x2394 0x2414 0x20ac 0x215c 0x220c 0x2008 0x200c 0x2010 0x2014>;
			qcom,iommu-bfb-data = <0xffff 0x00 0x04 0x04 0x00 0x00 0x10 0x50 0x00 0x10 0x20 0x00 0x00 0x00 0x00>;
			vdd-supply = <0x07>;
			qcom,iommu-enable-halt;

			qcom,iommu-ctx@fda6c000 {
				compatible = "qcom,msm-smmu-v1-ctx";
