		gpio_keys_evt {
			compatible = "gpio-keys";
			input-name = "gpio-keys";
			hwid-type = <0x00>;

			camera_focus {
				label = "camera_focus";
				gpios = <0x08 0x6c 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x210>;
				debounce-interval = <0x0f>;
			};

			camera_snapshot {
				label = "camera_snapshot";
				gpios = <0x08 0x6b 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x2fe>;
				gpio-key,wakeup;
				debounce-interval = <0x0f>;
			};

			vol_down {
				label = "volume_down";
				gpios = <0x08 0x6d 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x72>;
				gpio-key,wakeup;
				debounce-interval = <0x0f>;
			};
		};

		gpio_keys_dvt {
			compatible = "gpio-keys";
			input-name = "gpio-keys";
			hwid-type = <0x01>;

			camera_focus {
				label = "camera_focus";
				gpios = <0x08 0x6c 0x01>;
