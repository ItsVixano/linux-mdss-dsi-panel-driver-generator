			vol_down {
				label = "volume_down";
				gpios = <0x08 0x6a 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x72>;
				gpio-key,wakeup;
				debounce-interval = <0x0f>;
			};
		};

		gpio_hwid {
			compatible = "gpio-hwid";
			cci,project_id-gpios = <0x08 0x03 0x00 0x08 0x02 0x00>;
